{
  "name": "@vantageos/mcp-frameworks",
  "version": "1.0.5",
  "description": "MCP server: 16 thinking frameworks (SWOT, OKR, 5 Whys, Cynefin…) as 5 composable tools. Apply, chain, suggest. Bilingual FR+EN. stdio, no API key.",
  "description_fr": "Serveur MCP : 16 frameworks de pensée (SWOT, OKR, 5 Pourquoi, Cynefin…) en 5 outils composables. Appliquer, enchaîner, suggérer. Bilingue FR+EN.",
  "keywords": [
    "mcp",
    "claude-code",
    "frameworks",
    "thinking",
    "strategy",
    "decision",
    "innovation",
    "vantage",
    "elpi"
  ],
  "license": "MIT",
  "author": "ElPi Corp / Laurent Perello",
  "homepage": "https://github.com/elpiarthera/vantage-frameworks-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elpiarthera/vantage-frameworks-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/elpiarthera/vantage-frameworks-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vantage-frameworks-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "LICENSE",
    "mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evals": "node scripts/run-evals.js",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke-test-boot.sh",
    "prepublishOnly": "npm run build && npm run smoke && npm test && npm run evals"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "hono": "^4.12.25",
    "ip-address": "^10.3.1"
  }
}
